{
  "name": "compliance-scraper",
  "version": "1.0.0",
  "description": "Scrapes accessibility compliance statements from UK government digital services",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:server": "node dist/server/index.js",
    "dev": "ts-node src/main.ts",
    "dev:watch": "nodemon --watch src --ext ts,njk --exec ts-node src/main.ts",
    "dev:server": "ts-node src/server/index.ts",
    "lint": "eslint .",
    "test": "node --require ts-node/register --test $(find tests/unit -name '*.test.ts')",
    "test:e2e": "playwright test",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "fetch-services": "bash scripts/fetch-services.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1037.0",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "8.4.1",
    "express-session": "^1.19.0",
    "govuk-frontend": "^5.14.0",
    "helmet": "8.1.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.20.0",
    "pg-boss": "^10.4.2",
    "pgsql-ast-parser": "12.0.2",
    "playwright": "^1.59.1",
    "sanitize-html": "2.17.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.39",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
