{% extends "layout.njk" %}

{% block content %}

<h1 class="govuk-heading-xl">{{ title }}</h1>

<p class="govuk-body">
  Public sector services that collect personal data must publish a privacy notice under UK GDPR, identifying the data controller,
  the legal basis for processing, what data is shared and with whom, and how long it is retained.
  This page shows the latest result for each service — click a service name for the full detail.
</p>

<form method="get" action="/privacy" class="govuk-!-margin-bottom-4">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter">
      <div class="govuk-form-group govuk-!-margin-bottom-2">
        <label class="govuk-label govuk-label--s" for="organisation">Organisation</label>
        <select class="govuk-select govuk-!-width-full" id="organisation" name="organisation" data-auto-submit>
          <option value="">All organisations</option>
          {% for org in organisations %}
            <option value="{{ org }}" {% if currentFilters.organisation == org %}selected{% endif %}>{{ org }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
    {% if currentFilters.organisation %}
    <div class="govuk-grid-column-one-quarter govuk-!-padding-top-6">
      <a href="/privacy" class="govuk-link">Clear filters</a>
    </div>
    {% endif %}
  </div>
</form>

<p class="govuk-body">Showing {{ results | length }} of {{ total }} service(s){% if totalPages > 1 %} — page {{ page }} of {{ totalPages }}{% endif %}.</p>

{% if results.length > 0 %}
<table class="govuk-table">
  <caption class="govuk-table__caption govuk-table__caption--s">Privacy compliance results</caption>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col">Service</th>
      <th class="govuk-table__header" scope="col">Organisation</th>
      <th class="govuk-table__header" scope="col">Data controller</th>
      <th class="govuk-table__header" scope="col">Legal basis</th>
      <th class="govuk-table__header" scope="col">Last updated</th>
      <th class="govuk-table__header" scope="col">Last checked</th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    {% for r in results %}
    <tr class="govuk-table__row">
      <td class="govuk-table__cell">
        <a href="/services/{{ r.serviceSlug }}#privacy" class="govuk-link">{{ r.serviceName }}</a>
      </td>
      <td class="govuk-table__cell">{{ r.organisation }}</td>
      <td class="govuk-table__cell">
        {% if r.dataControllers and r.dataControllers.length > 0 %}
          {{ r.dataControllers[0].name }}{% if r.dataControllers.length > 1 %} (+{{ r.dataControllers.length - 1 }}){% endif %}
        {% else %}
          <strong class="govuk-tag govuk-tag--grey">Unknown</strong>
          {% if r.scrapeStatus == 'no_link_found' %}
            <br><span class="govuk-body-s">No privacy notice found</span>
          {% elif r.scrapeStatus == 'scrape_error' %}
            <br><span class="govuk-body-s">{{ r.errorMessage or 'Could not access page' }}</span>
          {% elif r.scrapeStatus == 'bedrock_error' %}
            <br><span class="govuk-body-s">Page found but could not extract data</span>
          {% elif r.scrapeStatus == 'no_data_extracted' %}
            <br><span class="govuk-body-s">{{ r.errorMessage or 'Page did not contain a privacy notice' }}</span>
          {% endif %}
        {% endif %}
      </td>
      <td class="govuk-table__cell govuk-body-s">{{ r.legalBasis or '—' }}</td>
      <td class="govuk-table__cell govuk-body-s">{{ r.lastUpdatedDate or '—' }}</td>
      <td class="govuk-table__cell govuk-body-s">{{ r.scrapedAt | string | truncate(10, true, '') }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if totalPages > 1 %}
{% set basePath = '/privacy' %}
{% include "pagination.njk" %}
{% endif %}

{% else %}
<p class="govuk-body">No results match the current filters.</p>
{% endif %}

{% endblock %}
