<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0b0c0c">
  <meta name="csrf-token" content="{{ csrfToken }}">
  <title>{{ title }} – Compliance Scraper</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/public/govuk-frontend.min.css">
  <style nonce="{{ cspNonce }}">
    .app-header-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: #ffffff;
    }
    .app-header-logo:link,
    .app-header-logo:visited,
    .app-header-logo:hover {
      color: #ffffff;
      text-decoration: none;
    }
    .app-header-logo__crown {
      height: 30px;
      width: 26px;
      filter: brightness(0) invert(1);
    }
    .app-header-logo__name {
      font-family: "GDS Transport", arial, sans-serif;
      font-size: 19px;
      font-weight: 700;
      color: #ffffff;
    }
  </style>
</head>
<body class="govuk-template__body">
  <script nonce="{{ cspNonce }}">document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');</script>

  <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link">Skip to main content</a>

  <header class="govuk-template__header">
    <div class="govuk-header">
      <div class="govuk-header__container govuk-width-container">
        <div class="govuk-header__logo">
          <a href="/" class="app-header-logo">
            <img src="/public/assets/images/govuk-crest.svg" alt="" class="app-header-logo__crown">
            <span class="app-header-logo__name">Department for Science, Innovation and Technology</span>
          </a>
        </div>
        {% if user %}
        <div class="govuk-header__content">
          <nav aria-label="Account" class="govuk-header__navigation">
            <ul class="govuk-header__navigation-list">
              <li class="govuk-header__navigation-item">
                <span class="govuk-header__link">{{ user.name }}</span>
              </li>
              <li class="govuk-header__navigation-item">
                <a class="govuk-header__link" href="/auth/logout">Sign out</a>
              </li>
            </ul>
          </nav>
        </div>
        {% endif %}
      </div>
    </div>
  </header>

  {% if user %}
  <nav class="govuk-service-navigation" data-module="govuk-service-navigation" aria-label="Service">
    <div class="govuk-width-container">
      <ul class="govuk-service-navigation__list">
        <li class="govuk-service-navigation__item">
          <a class="govuk-service-navigation__link" href="/accessibility">Accessibility</a>
        </li>
        <li class="govuk-service-navigation__item">
          <a class="govuk-service-navigation__link" href="/cookies">Cookies</a>
        </li>
        <li class="govuk-service-navigation__item">
          <a class="govuk-service-navigation__link" href="/privacy">Privacy</a>
        </li>
        <li class="govuk-service-navigation__item">
          <a class="govuk-service-navigation__link" href="/insights">Insights</a>
        </li>
        <li class="govuk-service-navigation__item">
          <a class="govuk-service-navigation__link" href="/workers">Workers</a>
        </li>
      </ul>
    </div>
  </nav>
  {% endif %}

  <div class="govuk-width-container">
    <div class="govuk-phase-banner">
      <p class="govuk-phase-banner__content">
        <strong class="govuk-tag govuk-phase-banner__content__tag">Alpha</strong>
        <span class="govuk-phase-banner__text">
          This is a new service – your <a class="govuk-link" href="mailto:observability@dsit.gov.uk?subject=Compliance%20Scraper%20feedback">feedback</a> will help us to improve it.
        </span>
      </p>
    </div>

    <main class="govuk-main-wrapper" id="main-content">
      {% block content %}{% endblock %}
    </main>
  </div>

  <footer class="govuk-template__footer">
    <div class="govuk-footer">
      <div class="govuk-width-container">
        <div class="govuk-footer__meta">
          <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <ul class="govuk-footer__inline-list">
              <li class="govuk-footer__inline-list-item">
                <a class="govuk-footer__link" href="/accessibility-statement">Accessibility statement</a>
              </li>
              <li class="govuk-footer__inline-list-item">
                <a class="govuk-footer__link" href="/cookie-policy">Cookies</a>
              </li>
              <li class="govuk-footer__inline-list-item">
                <a class="govuk-footer__link" href="/privacy-policy">Privacy</a>
              </li>
            </ul>
            <svg aria-hidden="true" focusable="false" class="govuk-footer__licence-logo"
              xmlns="http://www.w3.org/2000/svg" viewBox="0 0 483.2 195.7" height="17" width="41">
              <path fill="currentColor"
                d="M421.5 142.8V.1l-50.7 32.3v161.1h112.4v-50.7zm-122.3-9.6A47.12 47.12 0 0 1 221 97.8c0-26 21.1-47.1 47.1-47.1 16.7 0 31.4 8.7 39.7 21.8l42.7-27.2A97.63 97.63 0 0 0 268.1 0c-36.5 0-68.3 20.1-85.1 49.7A98 98 0 0 0 97.8 0C43.9 0 0 43.9 0 97.8s43.9 97.8 97.8 97.8c36.5 0 68.3-20.1 85.1-49.7a97.76 97.76 0 0 0 149.6 25.4l19.4 22.2h3v-87.8h-80l24.3 27.5zM97.8 145c-26 0-47.1-21.1-47.1-47.1s21.1-47.1 47.1-47.1 47.2 21 47.2 47S123.8 145 97.8 145">
              </path>
            </svg>
            <span class="govuk-footer__licence-description">
              All content is available under the
              <a class="govuk-footer__link"
                href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" rel="license">Open
                Government Licence v3.0</a>, except where otherwise stated
            </span>
          </div>
          <div class="govuk-footer__meta-item">
            <a class="govuk-footer__link govuk-footer__copyright-logo"
              href="https://www.nationalarchives.gov.uk/information-management/re-using-public-sector-information/uk-government-licensing-framework/crown-copyright/">
              &copy; Crown copyright
            </a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <script nonce="{{ cspNonce }}" type="module" src="/public/govuk-frontend.min.js"></script>
  <script nonce="{{ cspNonce }}">
    document.querySelectorAll('[data-trigger-url]').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var url = btn.dataset.triggerUrl;
        var orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Queuing…';
        try {
          var res = await fetch(url, { method: 'POST', headers: { 'x-csrf-token': document.querySelector('meta[name="csrf-token"]').content } });
          if (res.ok) {
            var tag = document.createElement('strong');
            tag.className = 'govuk-tag govuk-tag--green';
            tag.textContent = 'Queued';
            btn.replaceWith(tag);
          } else {
            btn.disabled = false;
            btn.textContent = orig;
          }
        } catch (_) {
          btn.disabled = false;
          btn.textContent = orig;
        }
      });
    });
  </script>
  <script nonce="{{ cspNonce }}">
    document.querySelectorAll('select[data-auto-submit]').forEach(function(el) {
      el.addEventListener('change', function() { el.form.submit(); });
    });
  </script>
</body>
</html>
